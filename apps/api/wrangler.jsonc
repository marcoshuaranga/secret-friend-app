{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secret-friend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "send_metrics": false,
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "secret-friend",
      // El workflow de despliegue lo reemplaza con la variable D1_DATABASE_ID de GitHub.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Limpieza diaria de eventos vencidos y dispositivos sin eventos (04:17 UTC).
  "triggers": { "crons": ["17 4 * * *"] },
  "observability": { "enabled": true }
}
