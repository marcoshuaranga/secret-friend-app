{
  "name": "@secret-friend/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit && tsc --noEmit -p features/support",
    "test": "cucumber-js"
  },
  "dependencies": {
    "@secret-friend/contract": "workspace:*",
    "@secret-friend/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@cucumber/cucumber": "^13.3.0",
    "@secret-friend/web": "workspace:*",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.165.0"
  }
}
