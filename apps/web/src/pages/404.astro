---
import { Button } from "@/components/starwind/button";
import { t } from "@/i18n/es";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Página no encontrada">
  <h1 class="text-2xl font-bold tracking-tight">Esta página no existe</h1>
  <p class="text-muted-foreground">Revisa el enlace o vuelve al inicio.</p>
  <Button href="/" variant="outline">{t.backHome}</Button>
</Layout>
