---
import { t } from "@/i18n/es";
---

<sf-roulette class="block">
  <div
    class="roulette relative overflow-hidden rounded-3xl p-3 shadow-xl select-none"
    data-stage
  >
    <div class="lights" aria-hidden="true"></div>
    <div
      class="window relative h-[13.5rem] overflow-hidden rounded-2xl bg-neutral-950 ring-2 ring-amber-300/70"
      data-window
      tabindex="0"
      role="button"
      aria-label={`${t.swipe} o pulsa Enter para girar`}
    >
      <ul class="reel absolute inset-x-0 top-0" data-reel aria-hidden="true"></ul>
      <div class="payline pointer-events-none absolute inset-x-2 top-1/2 h-[4.5rem] -translate-y-1/2 rounded-xl"></div>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-neutral-950 via-transparent to-neutral-950"></div>
    </div>
    <div class="mt-3 flex items-center justify-between gap-3 px-1">
      <button
        type="button"
        data-sound
        aria-pressed="false"
        class="rounded-full px-3 py-1.5 text-xs font-medium text-amber-100/80 ring-1 ring-amber-200/30"
      >
        🔇 {t.sound}
      </button>
      <span class="hint text-sm font-semibold tracking-wide text-amber-200" data-hint>⬇ {t.swipe}</span>
    </div>
  </div>
  <div class="mt-4 flex flex-col items-center gap-2">
    <button
      type="button"
      data-spin
      class="h-14 w-full rounded-2xl bg-gradient-to-b from-amber-300 to-amber-500 text-lg font-bold text-neutral-950 shadow-lg active:translate-y-px disabled:opacity-50"
    >
      {t.spin}
    </button>
    <p class="text-sm text-muted-foreground">{t.spinOnce}</p>
  </div>
  <p class="sr-only" aria-live="assertive" data-announce></p>
</sf-roulette>

<style>
  .roulette {
    background: radial-gradient(120% 80% at 50% 0%, #3b0764, #0f0a1f 70%);
  }
  .lights {
    position: absolute;
    inset: 3px;
    border: 5px dotted #fde68a;
    border-radius: 1.45rem;
    animation: marquee 0.8s steps(1) infinite;
  }
  .reel :global(li) {
    height: 4.5rem;
    display: grid;
    place-items: center;
    padding-inline: 1rem;
    font-size: 1.6rem;
    font-weight: 800;
    color: #fef3c7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .payline {
    box-shadow:
      inset 0 0 0 2px #fbbf24,
      0 0 24px #f59e0b88;
  }
  :global(sf-roulette[data-state="done"]) .payline {
    animation: win 0.6s ease-in-out 3;
  }
  :global(sf-roulette[data-state="spinning"]) .hint {
    visibility: hidden;
  }
  .hint {
    animation: nudge 1.4s ease-in-out infinite;
  }
  @keyframes marquee {
    50% {
      border-color: #f59e0b;
    }
  }
  @keyframes win {
    50% {
      box-shadow:
        inset 0 0 0 3px #fde68a,
        0 0 48px #fbbf24;
    }
  }
  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lights,
    .hint,
    :global(sf-roulette[data-state="done"]) .payline {
      animation: none;
    }
  }
</style>

<script>
  import { readFlag, writeFlag } from "@/lib/storage";

  const ITEM_REM = 4.5;
  const SOUND_KEY = "sf:sound";
  const prefersReducedMotion = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
  const easeOut = (p: number) => 1 - (1 - p) ** 4;

  /**
   * Ruleta tipo tragamonedas (RF-7, RF-8, RF-10, RF-15). No decide nada: pide el giro con
   * el evento `sf-spin-request` y anima la tira que le entregan con `play()`.
   */
  class SfRoulette extends HTMLElement {
    private audio: AudioContext | undefined;
    private sound = readFlag(SOUND_KEY);
    private pointerStart: { y: number; t: number } | undefined;

    connectedCallback() {
      this.dataset.state = "idle";
      this.find("[data-spin]").addEventListener("click", () => this.request(1));
      const windowEl = this.find("[data-window]");
      windowEl.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          this.request(1);
        }
      });
      windowEl.addEventListener("pointerdown", (event) => {
        this.pointerStart = { y: event.clientY, t: performance.now() };
        windowEl.setPointerCapture(event.pointerId);
      });
      windowEl.addEventListener("pointerup", (event) => {
        const start = this.pointerStart;
        this.pointerStart = undefined;
        if (!start) return;
        const distance = event.clientY - start.y;
        const speed = distance / Math.max(performance.now() - start.t, 16);
        if (distance > 40) this.request(Math.min(Math.max(speed, 0.5), 3));
      });
      windowEl.style.touchAction = "none";
      this.renderSound();
      this.find("[data-sound]").addEventListener("click", () => {
        this.sound = !this.sound;
        writeFlag(SOUND_KEY, this.sound);
        this.renderSound();
      });
    }

    /** Muestra los nombres iniciales en el carrete, sin girar. */
    preview(names: readonly string[]) {
      this.fill(names);
    }

    /** Anima la tira y termina en su último nombre. `force` (0.5–3) viene del swipe. */
    async play(reel: readonly string[], force = 1): Promise<void> {
      this.dataset.state = "spinning";
      this.fill(reel);
      const list = this.find("[data-reel]");
      const item = parseFloat(getComputedStyle(document.documentElement).fontSize) * ITEM_REM;
      const distance = (reel.length - 1) * item; // deja el último nombre en la fila central
      const duration = prefersReducedMotion() ? 0 : 4200 + 1200 / force;
      let lastIndex = -1;
      await new Promise<void>((resolve) => {
        const start = performance.now();
        const frame = (now: number) => {
          const progress = duration === 0 ? 1 : Math.min((now - start) / duration, 1);
          const offset = distance * easeOut(progress);
          list.style.transform = `translateY(${-offset}px)`;
          const index = Math.floor(offset / item);
          if (index !== lastIndex) {
            lastIndex = index;
            this.tick();
          }
          if (progress < 1) requestAnimationFrame(frame);
          else resolve();
        };
        requestAnimationFrame(frame);
      });
      this.dataset.state = "done";
      navigator.vibrate?.(120);
      this.find("[data-announce]").textContent = reel.at(-1) ?? "";
      if (!prefersReducedMotion()) {
        // Sin Web Worker: la CSP solo permite scripts propios.
        const { default: confetti } = await import("canvas-confetti");
        const fire = confetti.create(undefined, { resize: true, useWorker: false });
        void fire({ particleCount: 160, spread: 80, origin: { y: 0.45 }, disableForReducedMotion: true });
      }
    }

    private request(force: number) {
      if (this.dataset.state !== "idle") return;
      this.dataset.state = "requested";
      this.find<HTMLButtonElement>("[data-spin]").disabled = true;
      this.dispatchEvent(new CustomEvent("sf-spin-request", { detail: { force } }));
    }

    /** Si el giro falló (p. ej. sin conexión), vuelve a permitirlo. */
    reset() {
      this.dataset.state = "idle";
      this.find<HTMLButtonElement>("[data-spin]").disabled = false;
    }

    private fill(names: readonly string[]) {
      // Un nombre de relleno arriba para que el primero quede centrado en la ventana.
      const padded = ["", ...names, ""];
      this.find("[data-reel]").replaceChildren(
        ...padded.map((name) => {
          const li = document.createElement("li");
          li.textContent = name;
          return li;
        }),
      );
      this.find("[data-reel]").style.transform = "translateY(0)";
    }

    private tick() {
      if (!this.sound) return;
      this.audio ??= new AudioContext();
      const osc = this.audio.createOscillator();
      const gain = this.audio.createGain();
      osc.frequency.value = 1400;
      gain.gain.setValueAtTime(0.08, this.audio.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.0001, this.audio.currentTime + 0.04);
      osc.connect(gain).connect(this.audio.destination);
      osc.start();
      osc.stop(this.audio.currentTime + 0.05);
    }

    private renderSound() {
      const button = this.find("[data-sound]");
      button.setAttribute("aria-pressed", String(this.sound));
      button.textContent = `${this.sound ? "🔊" : "🔇"} Sonido`;
    }

    private find<T extends HTMLElement = HTMLElement>(selector: string): T {
      const found = this.querySelector<T>(selector);
      if (!found) throw new Error(`sf-roulette: falta ${selector}`);
      return found;
    }
  }

  customElements.define("sf-roulette", SfRoulette);
</script>
