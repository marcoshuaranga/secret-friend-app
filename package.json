{
  "name": "secret-friend-app",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "biome check .",
    "verify": "pnpm check && pnpm typecheck && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @secret-friend/e2e test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
