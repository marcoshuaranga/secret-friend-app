{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!**/*.md",
      "!**/components/starwind",
      "!**/styles/starwind.css",
      "!**/starwind.config.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "useConst": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod": "Importa desde \"zod/mini\"; el paquete completo \"zod\" no se usa en este proyecto.",
              "zod/v4": "Importa desde \"zod/mini\"; el paquete completo \"zod\" no se usa en este proyecto.",
              "zod/v3": "Importa desde \"zod/mini\"; el paquete completo \"zod\" no se usa en este proyecto.",
              "zod/v4/core": "Importa desde \"zod/mini\"; el paquete completo \"zod\" no se usa en este proyecto."
            }
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useImportType": "off"
          }
        }
      }
    }
  ]
}
